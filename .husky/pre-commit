#!/usr/bin/env sh
set -e

echo ""
echo "========================================" >&2
echo "  husky: pre-commit hook starting" >&2
echo "========================================" >&2

# Collect staged source files
FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|json|md|yml|yaml)$' || true)

if [ -z "$FILES" ]; then
  echo "husky: no staged source files, skipping checks." >&2
  exit 0
fi

echo "husky: staged files:" >&2
echo "$FILES" | sed 's/^/  - /' >&2
echo "" >&2

# Biome lint + auto-fix on staged files
echo "> [1/3] Running biome check on staged files..." >&2
./node_modules/.bin/biome check --write --no-errors-on-unmatched $FILES
echo "husky: biome check passed." >&2

# Re-stage any auto-fixed files
echo "husky: re-staging auto-fixed files..." >&2
echo "$FILES" | xargs git add --
echo "husky: re-staged." >&2

# TypeScript type check
echo "" >&2
echo "> [2/3] Running TypeScript type check..." >&2
./node_modules/.bin/tsc --noEmit
echo "husky: TypeScript check passed." >&2

# Unit tests only (no integration tests - those need Docker infra)
echo "" >&2
echo "> [3/3] Running unit tests..." >&2
./node_modules/.bin/vitest run --exclude '**/*.integration.test.ts' --reporter=basic
echo "husky: unit tests passed." >&2

echo "" >&2
echo "========================================" >&2
echo "  husky: all checks passed!" >&2
echo "========================================" >&2
